{
  "expo": {
    "name": "CareNow",
    "slug": "CareNow",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/carenow-icon.png",
    "scheme": "carenow",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp"
        ]
      },
      "bundleIdentifier": "com.dhritiinfotechexpo.CareNow"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./src/assets/images/carenow-icon-foreground.png",
        "backgroundImage": "./src/assets/images/android-icon-background.png",
        "monochromeImage": "./src/assets/images/carenow-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dhritiinfotechexpo.CareNow",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./src/assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/carenow-splash.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow CareNow to access your photos so you can update your profile picture.",
          "cameraPermission": "Allow CareNow to use your camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CareNow to use your location to show your current location and connect you with nearby healthcare services."
        }
      ],
      "expo-image",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fb2b61f8-f502-41a7-a507-9ec241bb5c91"
      }
    },
    "owner": "dhriti-infotech-expo"
  }
}
